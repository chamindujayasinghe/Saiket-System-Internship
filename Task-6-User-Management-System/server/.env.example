# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your password never gets committed.

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=saiket_user_management

# Origin of the React client (for CORS)
CLIENT_URL=http://localhost:5173
